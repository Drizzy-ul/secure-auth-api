# Application
PROJECT_NAME="SecureAuth API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Security (Generate a secure key using: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY="replace-this-with-a-random-secret-key-at-least-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MFA_TOKEN_EXPIRE_MINUTES=5

# MFA Configuration
MFA_ISSUER_NAME="SecureAuth"
MFA_BACKUP_CODE_COUNT=10

# Database Configuration
# Local SQLite Async:
DATABASE_URL="sqlite+aiosqlite:///./secure_auth.db"
# Production PostgreSQL Async:
# DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/secure_auth_db"

# CORS Origins (Comma-separated or JSON list)
CORS_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000"

# Rate Limiting
RATE_LIMIT_DEFAULT="100/minute"
RATE_LIMIT_LOGIN="5/minute"
RATE_LIMIT_REGISTER="5/minute"
RATE_LIMIT_MFA="10/minute"
